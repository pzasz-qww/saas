# Copie este arquivo para portable.env somente se quiser alterar os padrões.
# O arquivo portable.env não deve ser versionado.

# Porta usada pelo servidor local.
PORTABLE_PORT=8000

# Use false para não abrir o navegador automaticamente.
PORTABLE_OPEN_BROWSER=true

# Use false apenas para diagnóstico, se os arquivos estáticos já estiverem prontos.
PORTABLE_COLLECTSTATIC=true
